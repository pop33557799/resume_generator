# Copy this file to ".env" and paste your OpenAI API key below.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-paste-your-new-key-here

# Optional: which model to use. gpt-4o is best quality; gpt-4o-mini is cheaper.
OPENAI_MODEL=gpt-4o

# Optional: NVIDIA (free key at https://build.nvidia.com — sign in, open any model,
# "Get API Key"). Pick "NVIDIA" as the AI provider on the Generate page.
# Model ids: https://build.nvidia.com/models
NVIDIA_API_KEY=nvapi-paste-your-key-here
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash

# Optional: OpenRouter (https://openrouter.ai/keys) — pick "OpenRouter" as the
# AI provider on the Generate page. Model ids: https://openrouter.ai/models
OPENROUTER_API_KEY=sk-or-paste-your-key-here
OPENROUTER_MODEL=openai/gpt-4o
