# Copy this file to ".env" and paste your OpenAI API key below.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-paste-your-new-key-here

# Optional: which model to use. gpt-4o is best quality; gpt-4o-mini is cheaper.
OPENAI_MODEL=gpt-4o

# Optional: Gemini (https://aistudio.google.com/apikey) — pick "Gemini" as the
# AI provider on the Generate page. Model ids: https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=paste-your-key-here
GEMINI_MODEL=gemini-3.8-flash

# Optional: Groq (https://console.groq.com/keys) — pick "Groq" as the AI provider
# on the Generate page. Model ids: https://console.groq.com/docs/models
GROQ_API_KEY=gsk_paste-your-key-here
GROQ_MODEL=openai/gpt-oss-120b
